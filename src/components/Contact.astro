---
---

<section id="contact" class="relative overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src="/images/hero-porch.png"
      alt=""
      class="w-full h-full object-cover object-bottom"
      style="filter: contrast(1.05) saturate(0.9);"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-void/60"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-void via-void/40 to-void/20"></div>
  </div>

  <!-- Floating wisps -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="ct-wisp ct-wisp-1"></div>
    <div class="ct-wisp ct-wisp-2"></div>
    <div class="ct-wisp ct-wisp-3"></div>
    <div class="ct-wisp ct-wisp-4"></div>
  </div>

  <div class="relative z-10 mx-auto px-6 lg:px-8 py-24 md:py-32 lg:py-40" style="width: min(85vw, 900px);">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="section-label text-amber font-sans font-medium text-sm mb-4" style="font-variant: all-small-caps; letter-spacing: 0.15em;">Get In Touch</p>
      <h2 class="section-title font-display text-glow leading-tight" style="font-size: var(--text-h1)">
        Let's build something together.
      </h2>
    </div>

    <!-- Form -->
    <form
      name="contact"
      method="POST"
      action="/success"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="contact-form max-w-lg mx-auto space-y-8"
    >
      <!-- Honeypot field for spam prevention -->
      <p class="hidden" aria-hidden="true">
        <label>
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <input type="hidden" name="form-name" value="contact" />

      <!-- Name -->
      <div class="form-field relative">
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder=" "
          class="w-full px-0 py-3 bg-transparent border-0 border-b border-cloud/20 text-glow placeholder-transparent focus:outline-none focus:border-amber transition-colors duration-300 font-sans"
        />
        <label for="name" class="floating-label absolute left-0 top-3 text-cloud/60 text-sm font-sans pointer-events-none transition-all duration-300">
          Name
        </label>
      </div>

      <!-- Email -->
      <div class="form-field relative">
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder=" "
          class="w-full px-0 py-3 bg-transparent border-0 border-b border-cloud/20 text-glow placeholder-transparent focus:outline-none focus:border-amber transition-colors duration-300 font-sans"
        />
        <label for="email" class="floating-label absolute left-0 top-3 text-cloud/60 text-sm font-sans pointer-events-none transition-all duration-300">
          Email
        </label>
      </div>

      <!-- Message -->
      <div class="form-field relative">
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          placeholder=" "
          class="w-full px-0 py-3 bg-transparent border-0 border-b border-cloud/20 text-glow placeholder-transparent focus:outline-none focus:border-amber transition-colors duration-300 resize-none font-sans"
        ></textarea>
        <label for="message" class="floating-label absolute left-0 top-3 text-cloud/60 text-sm font-sans pointer-events-none transition-all duration-300">
          Message
        </label>
      </div>

      <!-- Submit -->
      <div class="pt-4">
        <button
          type="submit"
          class="w-full bg-amber hover:bg-ember text-void font-medium py-4 px-6 rounded-full transition-all duration-300 hover:shadow-[0_0_30px_rgba(212,146,58,0.3)] font-sans"
        >
          Send Message
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  /* Floating label pattern */
  .form-field input:focus ~ .floating-label,
  .form-field input:not(:placeholder-shown) ~ .floating-label,
  .form-field textarea:focus ~ .floating-label,
  .form-field textarea:not(:placeholder-shown) ~ .floating-label {
    top: -0.75rem;
    font-size: 0.7rem;
    color: var(--color-amber);
  }

  /* Contact wisps */
  .ct-wisp {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    background: rgba(212, 146, 58, 0.7);
  }

  .ct-wisp-1 {
    left: 12%; top: 25%;
    width: 3px; height: 3px;
    box-shadow: 0 0 6px 2px rgba(212, 146, 58, 0.3);
    animation: ctDrift1 22s ease-in-out infinite, ctGlow 3.5s ease-in-out infinite alternate;
  }
  .ct-wisp-2 {
    left: 75%; top: 30%;
    width: 4px; height: 4px;
    box-shadow: 0 0 8px 2px rgba(212, 146, 58, 0.4);
    animation: ctDrift2 18s ease-in-out infinite, ctGlow 2.5s ease-in-out infinite alternate;
    animation-delay: -5s, -1s;
  }
  .ct-wisp-3 {
    left: 85%; top: 65%;
    width: 2px; height: 2px;
    box-shadow: 0 0 5px 1px rgba(212, 146, 58, 0.2);
    animation: ctDrift3 25s ease-in-out infinite, ctGlow 4s ease-in-out infinite alternate;
    animation-delay: -10s, -2s;
  }
  .ct-wisp-4 {
    left: 30%; top: 70%;
    width: 3px; height: 3px;
    box-shadow: 0 0 6px 1px rgba(212, 146, 58, 0.3);
    animation: ctDrift4 20s ease-in-out infinite, ctGlow 3s ease-in-out infinite alternate;
    animation-delay: -8s, -1.5s;
  }

  @keyframes ctGlow {
    0%   { opacity: 0.15; }
    100% { opacity: 0.75; }
  }
  @keyframes ctDrift1 {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(35px, -20px); }
    50%  { transform: translate(-15px, -45px); }
    75%  { transform: translate(40px, -15px); }
  }
  @keyframes ctDrift2 {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(-30px, -25px); }
    50%  { transform: translate(20px, -50px); }
    75%  { transform: translate(-45px, -20px); }
  }
  @keyframes ctDrift3 {
    0%, 100% { transform: translate(0, 0); }
    33%  { transform: translate(-25px, -35px); }
    66%  { transform: translate(25px, -15px); }
  }
  @keyframes ctDrift4 {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(20px, -30px); }
    50%  { transform: translate(-35px, -15px); }
    75%  { transform: translate(15px, -40px); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('#contact .section-label', {
    scrollTrigger: { trigger: '#contact', start: 'top 85%' },
    y: 30, opacity: 0, duration: 0.8, ease: 'power3.out'
  });

  gsap.from('#contact .section-title', {
    scrollTrigger: { trigger: '#contact', start: 'top 85%' },
    y: 40, opacity: 0, duration: 0.8, delay: 0.1, ease: 'power3.out'
  });

  gsap.from('#contact .contact-form', {
    scrollTrigger: { trigger: '#contact .contact-form', start: 'top 85%' },
    y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
  });
</script>
