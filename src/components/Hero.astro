---
---

<section id="hero" class="relative min-h-screen flex items-end overflow-hidden">
  <!-- Background Image with Parallax -->
  <div class="absolute inset-0 hero-parallax">
    <img
      src="/images/1.png"
      alt="Farmhouse porch at twilight with telescope and rocking chair, looking out toward the horizon"
      class="w-full h-full object-cover object-bottom hero-image"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-r from-void/80 via-void/40 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-void via-void/30 to-void/10"></div>
  </div>

  <!-- Floating wisps -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="wisp wisp-1"></div>
    <div class="wisp wisp-2"></div>
    <div class="wisp wisp-3"></div>
    <div class="wisp wisp-4"></div>
    <div class="wisp wisp-5"></div>
    <div class="wisp wisp-6"></div>
  </div>

  <!-- Content — lower-left positioning -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 pb-20 md:pb-28 lg:pb-32 pt-24">
    <div class="max-w-3xl">
      <!-- Main Headline -->
      <h1 class="hero-headline font-display font-semibold text-glow leading-[1.05] mb-8 tracking-[-0.02em]" style="font-size: var(--text-hero)">
        A wider view of what your business can be.
      </h1>

      <!-- Single CTA -->
      <div class="hero-cta">
        <a
          href="#contact"
          class="inline-flex items-center gap-3 bg-amber hover:bg-ember text-void px-8 py-4 font-medium rounded-full transition-all duration-300 hover:shadow-[0_0_30px_rgba(212,146,58,0.3)]"
        >
          Start a project
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-image {
    filter: contrast(1.05) saturate(0.9);
  }

  /* Floating wisps — warm amber fireflies */
  .wisp {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    background: rgba(212, 146, 58, 0.7);
  }

  .wisp-1 {
    left: 8%;  top: 25%;
    width: 4px; height: 4px;
    box-shadow: 0 0 8px 2px rgba(212, 146, 58, 0.4);
    animation: wispDrift1 20s ease-in-out infinite, wispGlow 3s ease-in-out infinite alternate;
  }
  .wisp-2 {
    left: 70%; top: 20%;
    width: 3px; height: 3px;
    box-shadow: 0 0 6px 2px rgba(212, 146, 58, 0.3);
    animation: wispDrift2 24s ease-in-out infinite, wispGlow 4s ease-in-out infinite alternate;
    animation-delay: -4s, -1s;
  }
  .wisp-3 {
    left: 45%; top: 65%;
    width: 5px; height: 5px;
    box-shadow: 0 0 10px 3px rgba(212, 146, 58, 0.5);
    animation: wispDrift3 18s ease-in-out infinite, wispGlow 2.5s ease-in-out infinite alternate;
    animation-delay: -8s, -0.5s;
  }
  .wisp-4 {
    left: 85%; top: 55%;
    width: 3px; height: 3px;
    box-shadow: 0 0 6px 1px rgba(212, 146, 58, 0.3);
    animation: wispDrift4 22s ease-in-out infinite, wispGlow 3.5s ease-in-out infinite alternate;
    animation-delay: -12s, -2s;
  }
  .wisp-5 {
    left: 25%; top: 45%;
    width: 2px; height: 2px;
    box-shadow: 0 0 5px 1px rgba(212, 146, 58, 0.2);
    animation: wispDrift5 26s ease-in-out infinite, wispGlow 4.5s ease-in-out infinite alternate;
    animation-delay: -15s, -3s;
  }
  .wisp-6 {
    left: 60%; top: 35%;
    width: 4px; height: 4px;
    box-shadow: 0 0 8px 2px rgba(212, 146, 58, 0.4);
    animation: wispDrift6 21s ease-in-out infinite, wispGlow 3s ease-in-out infinite alternate;
    animation-delay: -6s, -1.5s;
  }

  @keyframes wispGlow {
    0%   { opacity: 0.15; }
    100% { opacity: 0.8; }
  }

  @keyframes wispDrift1 {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(30px, -50px); }
    50%  { transform: translate(-15px, -90px); }
    75%  { transform: translate(45px, -35px); }
  }
  @keyframes wispDrift2 {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(-40px, -25px); }
    50%  { transform: translate(20px, -70px); }
    75%  { transform: translate(-55px, -40px); }
  }
  @keyframes wispDrift3 {
    0%, 100% { transform: translate(0, 0); }
    20%  { transform: translate(25px, -35px); }
    40%  { transform: translate(-30px, -75px); }
    60%  { transform: translate(40px, -50px); }
    80%  { transform: translate(-15px, -25px); }
  }
  @keyframes wispDrift4 {
    0%, 100% { transform: translate(0, 0); }
    25%  { transform: translate(-50px, -15px); }
    50%  { transform: translate(15px, -60px); }
    75%  { transform: translate(-35px, -80px); }
  }
  @keyframes wispDrift5 {
    0%, 100% { transform: translate(0, 0); }
    33%  { transform: translate(-30px, -50px); }
    66%  { transform: translate(30px, -25px); }
  }
  @keyframes wispDrift6 {
    0%, 100% { transform: translate(0, 0); }
    20%  { transform: translate(35px, -40px); }
    40%  { transform: translate(-20px, -65px); }
    60%  { transform: translate(50px, -30px); }
    80%  { transform: translate(-10px, -55px); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Set initial states
  gsap.set('.hero-headline', { y: 30, opacity: 0 });
  gsap.set('.hero-cta', { y: 20, opacity: 0 });

  // Hero entrance timeline
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.to('.hero-headline', {
    opacity: 1,
    y: 0,
    duration: 0.8,
  }, 0.4)
  .to('.hero-cta', {
    opacity: 1,
    y: 0,
    duration: 0.6,
  }, 0.8);

  // Parallax on hero image
  gsap.to('.hero-parallax img', {
    yPercent: 15,
    ease: 'none',
    scrollTrigger: {
      trigger: '#hero',
      start: 'top top',
      end: 'bottom top',
      scrub: true,
    },
  });
</script>
