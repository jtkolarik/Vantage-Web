---
---

<section id="services" class="relative" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
  <div class="absolute inset-0 bg-night"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-20">
      <p class="section-label text-amber font-sans font-medium text-sm mb-4" style="font-variant: all-small-caps; letter-spacing: 0.15em;">What We Do</p>
      <h2 class="section-title font-display text-glow leading-tight" style="font-size: var(--text-h1)">
        Websites that work as hard as you do.
      </h2>
    </div>

    <!-- Services — clean, no boxes -->
    <div class="grid md:grid-cols-3 gap-12 lg:gap-16">
      <!-- Web Design -->
      <div class="service-card">
        <h3 class="font-display text-glow mb-4" style="font-size: var(--text-h3)">Web Design</h3>
        <p class="text-cloud leading-relaxed" style="font-size: var(--text-body)">Clean, purposeful design that earns trust at first glance.</p>
      </div>

      <!-- Separator -->
      <div class="hidden md:block absolute left-1/3 top-0 bottom-0 w-px bg-glass-border" style="top: 60%; bottom: 10%;"></div>

      <!-- Development -->
      <div class="service-card">
        <h3 class="font-display text-glow mb-4" style="font-size: var(--text-h3)">Development</h3>
        <p class="text-cloud leading-relaxed" style="font-size: var(--text-body)">Fast, reliable code that loads in under two seconds.</p>
      </div>

      <!-- Separator -->
      <div class="hidden md:block absolute left-2/3 top-0 bottom-0 w-px bg-glass-border" style="top: 60%; bottom: 10%;"></div>

      <!-- SEO & Visibility -->
      <div class="service-card">
        <h3 class="font-display text-glow mb-4" style="font-size: var(--text-h3)">SEO & Visibility</h3>
        <p class="text-cloud leading-relaxed" style="font-size: var(--text-body)">The work that gets you found by the people who matter.</p>
      </div>
    </div>

    <!-- Mobile separators -->
    <div class="md:hidden space-y-12 mt-0">
      <!-- separators handled by border on cards below -->
    </div>
  </div>
</section>

<style>
  #services .grid {
    position: relative;
  }

  @media (max-width: 767px) {
    .service-card + .service-card {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 2rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section header reveal
  gsap.from('#services .section-label', {
    scrollTrigger: { trigger: '#services', start: 'top 85%' },
    y: 30, opacity: 0, duration: 0.8, ease: 'power3.out'
  });

  gsap.from('#services .section-title', {
    scrollTrigger: { trigger: '#services', start: 'top 85%' },
    y: 40, opacity: 0, duration: 0.8, delay: 0.1, ease: 'power3.out'
  });

  // Staggered card reveals
  gsap.from('#services .service-card', {
    scrollTrigger: { trigger: '#services .service-card', start: 'top 80%' },
    y: 60, opacity: 0, duration: 1, stagger: 0.15, ease: 'power3.out'
  });
</script>
