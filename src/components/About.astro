---
---

<section id="about" class="relative overflow-hidden" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
  <!-- Background: void with contrails at low opacity -->
  <div class="absolute inset-0 bg-void">
    <img
      src="/images/contrails.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-15"
      style="filter: contrast(1.05) saturate(0.9);"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-void/60 via-void/80 to-void"></div>
  </div>

  <div class="relative z-10 mx-auto px-6 lg:px-8" style="width: min(85vw, 900px);">
    <!-- Section Header -->
    <p class="section-label text-amber font-sans font-medium text-sm mb-4" style="font-variant: all-small-caps; letter-spacing: 0.15em;">Who We Are</p>
    <h2 class="section-title font-display text-glow leading-tight mb-8" style="font-size: var(--text-h1)">
      A small studio with a wide perspective
    </h2>

    <!-- Copy -->
    <p class="about-text text-lg text-cloud/80 leading-relaxed max-w-[42ch] mb-12" style="font-size: var(--text-body);">
      We're a small studio in the Midwest — where the sky is wide and good work speaks for itself. We build websites that earn trust at first glance and keep earning it in search results.
    </p>

    <!-- Stats -->
    <div class="about-stats pt-10 border-t border-glass-border">
      <div class="flex flex-wrap items-center gap-8 md:gap-12">
        <div>
          <p class="font-display text-4xl text-amber mb-1">100%</p>
          <p class="text-sm text-slate uppercase tracking-wider font-sans">Satisfaction</p>
        </div>
        <div class="w-px h-12 bg-glass-border hidden sm:block"></div>
        <div>
          <p class="font-display text-4xl text-amber mb-1">24hr</p>
          <p class="text-sm text-slate uppercase tracking-wider font-sans">Response</p>
        </div>
        <div class="w-px h-12 bg-glass-border hidden sm:block"></div>
        <div>
          <p class="font-display text-4xl text-amber mb-1">&infin;</p>
          <p class="text-sm text-slate uppercase tracking-wider font-sans">Revisions</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('#about .section-label', {
    scrollTrigger: { trigger: '#about', start: 'top 85%' },
    y: 30, opacity: 0, duration: 0.8, ease: 'power3.out'
  });

  gsap.from('#about .section-title', {
    scrollTrigger: { trigger: '#about', start: 'top 85%' },
    y: 40, opacity: 0, duration: 0.8, delay: 0.1, ease: 'power3.out'
  });

  gsap.from('#about .about-text', {
    scrollTrigger: { trigger: '#about .about-text', start: 'top 85%' },
    y: 30, opacity: 0, duration: 0.8, delay: 0.2, ease: 'power3.out'
  });

  gsap.from('#about .about-stats', {
    scrollTrigger: { trigger: '#about .about-stats', start: 'top 85%' },
    y: 30, opacity: 0, duration: 0.8, ease: 'power3.out'
  });
</script>
