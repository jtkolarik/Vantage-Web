---
const currentYear = new Date().getFullYear();
---

<footer class="relative bg-void border-t border-glass-border">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Wordmark -->
    <span class="font-display text-sm text-glow/80">Vantage Studio</span>

    <!-- Copyright -->
    <span class="text-sm text-steel font-sans">&copy; {currentYear}</span>
  </div>
</footer>
