---
const currentYear = new Date().getFullYear();
---

<footer class="relative">
  <!-- Full background image - taller min height on mobile to fit all content -->
  <div class="relative w-full min-h-[500px] md:min-h-0">
    <img
      src="/images/hero-porch.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-bottom md:relative md:h-auto"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-navy/40"></div>

    <!-- Floating particles -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="footer-particle footer-particle-1"></div>
      <div class="footer-particle footer-particle-2"></div>
      <div class="footer-particle footer-particle-3"></div>
      <div class="footer-particle footer-particle-4"></div>
      <div class="footer-particle footer-particle-5"></div>
      <div class="footer-particle footer-particle-6"></div>
      <div class="footer-particle footer-particle-7"></div>
      <div class="footer-particle footer-particle-8"></div>
    </div>

    <!-- Footer content overlaid on image -->
    <div class="absolute inset-0 flex flex-col justify-end pb-8">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 w-full">
        <div class="grid md:grid-cols-3 gap-8 md:gap-12 mb-8 md:mb-12">
          <!-- Brand -->
          <div>
            <div class="font-display text-2xl text-cream mb-4">Vantage Studio</div>
            <p class="text-cream/50 text-sm leading-relaxed">
              A wider view of what your business can be.
            </p>
          </div>

          <!-- Quick Links -->
          <div>
            <p class="text-cream/40 text-sm uppercase tracking-wider mb-4">Navigate</p>
            <div class="space-y-2">
              <a href="#services" class="block text-cream/60 hover:text-amber transition-colors">Services</a>
              <a href="#work" class="block text-cream/60 hover:text-amber transition-colors">Work</a>
              <a href="#about" class="block text-cream/60 hover:text-amber transition-colors">About</a>
              <a href="#contact" class="block text-cream/60 hover:text-amber transition-colors">Contact</a>
            </div>
          </div>

          <!-- Back to top -->
          <div class="md:text-right">
            <a
              href="#"
              class="inline-flex items-center gap-2 text-cream/50 hover:text-amber transition-colors group"
            >
              <span>Back to top</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:-translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
            </a>
          </div>
        </div>

        <div class="pt-8 border-t border-cream/5">
          <p class="text-sm text-cream/30">
            &copy; {currentYear} Vantage Studio. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Enhanced firefly particles */
  .footer-particle {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .footer-particle-1 { left: 5%; top: 20%; width: 4px; height: 4px; background: rgba(212, 165, 116, 0.8); box-shadow: 0 0 8px 2px rgba(212, 165, 116, 0.4); animation: ftFireflyPath1 18s ease-in-out infinite, ftFireflyPulse 3s ease-in-out infinite alternate; }
  .footer-particle-2 { left: 15%; top: 60%; width: 2px; height: 2px; background: rgba(232, 148, 90, 0.7); box-shadow: 0 0 6px 1px rgba(232, 148, 90, 0.3); animation: ftFireflyPath2 22s ease-in-out infinite, ftFireflyPulse 4s ease-in-out infinite alternate; animation-delay: -3s, -1s; }
  .footer-particle-3 { left: 65%; top: 25%; width: 5px; height: 5px; background: rgba(212, 165, 116, 0.9); box-shadow: 0 0 10px 3px rgba(212, 165, 116, 0.5); animation: ftFireflyPath3 20s ease-in-out infinite, ftFireflyPulse 2.5s ease-in-out infinite alternate; animation-delay: -5s, -0.5s; }
  .footer-particle-4 { left: 85%; top: 65%; width: 3px; height: 3px; background: rgba(212, 165, 116, 0.6); box-shadow: 0 0 6px 1px rgba(212, 165, 116, 0.3); animation: ftFireflyPath4 25s ease-in-out infinite, ftFireflyPulse 3.5s ease-in-out infinite alternate; animation-delay: -8s, -2s; }
  .footer-particle-5 { left: 45%; top: 75%; width: 4px; height: 4px; background: rgba(232, 148, 90, 0.8); box-shadow: 0 0 8px 2px rgba(232, 148, 90, 0.4); animation: ftFireflyPath5 19s ease-in-out infinite, ftFireflyPulse 3s ease-in-out infinite alternate; animation-delay: -12s, -1.5s; }
  .footer-particle-6 { left: 30%; top: 35%; width: 2px; height: 2px; background: rgba(212, 165, 116, 0.5); box-shadow: 0 0 5px 1px rgba(212, 165, 116, 0.2); animation: ftFireflyPath6 24s ease-in-out infinite, ftFireflyPulse 4.5s ease-in-out infinite alternate; animation-delay: -15s, -3s; }
  .footer-particle-7 { left: 75%; top: 45%; width: 6px; height: 6px; background: rgba(212, 165, 116, 0.7); box-shadow: 0 0 12px 4px rgba(212, 165, 116, 0.5); animation: ftFireflyPath7 21s ease-in-out infinite, ftFireflyPulse 2s ease-in-out infinite alternate; animation-delay: -10s, -0.8s; }
  .footer-particle-8 { left: 55%; top: 15%; width: 3px; height: 3px; background: rgba(232, 148, 90, 0.6); box-shadow: 0 0 7px 2px rgba(232, 148, 90, 0.3); animation: ftFireflyPath8 23s ease-in-out infinite, ftFireflyPulse 3.8s ease-in-out infinite alternate; animation-delay: -7s, -2.5s; }

  @keyframes ftFireflyPulse {
    0% { opacity: 0.2; box-shadow: 0 0 4px 1px rgba(212, 165, 116, 0.2); }
    100% { opacity: 0.9; box-shadow: 0 0 12px 4px rgba(212, 165, 116, 0.6); }
  }

  @keyframes ftFireflyPath1 {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(40px, -60px); }
    50% { transform: translate(-20px, -100px); }
    75% { transform: translate(60px, -40px); }
  }
  @keyframes ftFireflyPath2 {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-50px, -30px); }
    50% { transform: translate(30px, -80px); }
    75% { transform: translate(-70px, -50px); }
  }
  @keyframes ftFireflyPath3 {
    0%, 100% { transform: translate(0, 0); }
    20% { transform: translate(30px, -40px); }
    40% { transform: translate(-40px, -90px); }
    60% { transform: translate(50px, -60px); }
    80% { transform: translate(-20px, -30px); }
  }
  @keyframes ftFireflyPath4 {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(-60px, -20px); }
    50% { transform: translate(20px, -70px); }
    75% { transform: translate(-40px, -90px); }
  }
  @keyframes ftFireflyPath5 {
    0%, 100% { transform: translate(0, 0); }
    20% { transform: translate(50px, -50px); }
    40% { transform: translate(-30px, -20px); }
    60% { transform: translate(70px, -80px); }
    80% { transform: translate(10px, -40px); }
  }
  @keyframes ftFireflyPath6 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(-40px, -60px); }
    66% { transform: translate(40px, -30px); }
  }
  @keyframes ftFireflyPath7 {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(20px, -80px); }
    50% { transform: translate(-50px, -40px); }
    75% { transform: translate(30px, -60px); }
  }
  @keyframes ftFireflyPath8 {
    0%, 100% { transform: translate(0, 0); }
    20% { transform: translate(-30px, -50px); }
    40% { transform: translate(60px, -30px); }
    60% { transform: translate(-20px, -70px); }
    80% { transform: translate(40px, -20px); }
  }
</style>
