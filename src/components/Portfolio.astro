---
const projects = [
  {
    name: 'Redemption Electric',
    type: 'Electrical Services',
    url: 'https://redemptionelectric.netlify.app/',
    image: '/images/portfolio/redemption.PNG'
  },
  {
    name: 'Noble Contracting',
    type: 'Construction',
    url: 'https://noblecontracting.netlify.app/',
    image: '/images/portfolio/noble.PNG'
  },
  {
    name: 'Rydell',
    type: 'Tailor',
    url: 'https://rydell.netlify.app/',
    image: '/images/portfolio/rydell.PNG'
  }
];
---

<section id="work" class="relative overflow-hidden" style="padding-top: var(--section-gap); padding-bottom: var(--section-gap);">
  <!-- Background gradient from night to dusk -->
  <div class="absolute inset-0 bg-gradient-to-b from-night to-dusk"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 lg:mb-20">
      <p class="section-label text-amber font-sans font-medium text-sm mb-4" style="font-variant: all-small-caps; letter-spacing: 0.15em;">Selected Work</p>
      <h2 class="section-title font-display text-glow leading-tight" style="font-size: var(--text-h1)">
        Projects that speak for themselves
      </h2>
    </div>

    <!-- Full-width stacked cards -->
    <div class="space-y-10 lg:space-y-14">
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="portfolio-card group block"
        >
          <div class="relative overflow-hidden rounded-xl">
            <!-- Image -->
            <div class="aspect-[16/9] md:aspect-[21/9] overflow-hidden">
              <img
                src={project.image}
                alt={`${project.name} website screenshot`}
                class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                style="filter: contrast(1.05) saturate(0.9);"
                loading="lazy"
              />
            </div>

            <!-- Bottom gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-void/90 via-void/20 to-transparent"></div>

            <!-- Project info — bottom-left -->
            <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8">
              <div class="flex items-end justify-between">
                <div>
                  <p class="text-slate text-sm mb-1 tracking-wider uppercase font-sans">{project.type}</p>
                  <h3 class="font-display text-xl lg:text-2xl text-glow">
                    {project.name}
                  </h3>
                </div>
                <span class="view-link inline-flex items-center gap-1.5 text-amber text-sm font-sans font-medium transition-colors duration-300 group-hover:text-glow">
                  View Project
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Section header
  gsap.from('#work .section-label', {
    scrollTrigger: { trigger: '#work', start: 'top 85%' },
    y: 30, opacity: 0, duration: 0.8, ease: 'power3.out'
  });

  gsap.from('#work .section-title', {
    scrollTrigger: { trigger: '#work', start: 'top 85%' },
    y: 40, opacity: 0, duration: 0.8, delay: 0.1, ease: 'power3.out'
  });

  // Portfolio cards — scale up + fade
  gsap.utils.toArray('#work .portfolio-card').forEach((card: any) => {
    gsap.from(card, {
      scrollTrigger: { trigger: card, start: 'top 75%' },
      scale: 0.95,
      opacity: 0,
      duration: 1,
      ease: 'power3.out'
    });
  });
</script>
